# Copy to infra/.env (gitignored) and fill every value. Never commit real values.
# Local values only: production secrets live in Infisical (ADR-011), injected with
# `infisical run -- docker compose up` once #9 is done.
#
# Passwords end up in connection strings: use letters and digits only, e.g. `openssl rand -hex 24`.
# The role passwords are applied on the first start only (empty volume). To change them later:
# docker compose down --volumes, then up again (this deletes the local data).

# Superuser of the local instance
POSTGRES_PASSWORD=

# Host port for PostgreSQL, if 5432 is already taken on this machine (optional)
POSTGRES_HOST_PORT=

# One migrator (DDL) and one app (DML only) role per database
BFF_DB_MIGRATOR_PASSWORD=
BFF_DB_APP_PASSWORD=
ACCOUNT_DB_MIGRATOR_PASSWORD=
ACCOUNT_DB_APP_PASSWORD=
MENU_DB_MIGRATOR_PASSWORD=
MENU_DB_APP_PASSWORD=
CALENDAR_DB_MIGRATOR_PASSWORD=
CALENDAR_DB_APP_PASSWORD=
